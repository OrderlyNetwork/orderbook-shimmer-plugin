    "@orderly.network/types": ">=3.0.0-beta.1",
    "@orderly.network/ui": ">=3.0.0-beta.1",
    "@orderly.network/utils": ">=3.0.0-beta.1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@orderly.network/core": "3.0.4-alpha.2",
    "@orderly.network/plugin-storybook": "^0.0.1",
    "@orderly.network/react-app": "3.0.4-alpha.2",
    "@orderly.network/trading": "3.0.4-alpha.2",
    "@orderly.network/ts-config": "^0.0.2",
    "@orderly.network/ui": "3.0.4-alpha.2",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@storybook/react-webpack5": "^10.4.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.27",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "postcss": "^8.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^5.1.6",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.25.0"
