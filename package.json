{
  "name": "@orderly.network/orderbook-shimmer-plugin",
  "version": "0.0.6",
  "description": "Template for creating a new Orderly.network package",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
